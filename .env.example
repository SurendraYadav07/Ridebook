# Ride-Booker — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# Variables marked (frontend-safe) are the only ones that may ever be
# bundled into the mobile app; everything else is backend-only.

# -----------------------------------------------------------------------
# Database (PHASE 2)
# -----------------------------------------------------------------------
# Postgres connection string used by @workspace/db (Drizzle).
DATABASE_URL=postgresql://user:password@host:5432/ridebooker

# -----------------------------------------------------------------------
# API server (PHASE 4)
# -----------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API in production.
# Native mobile requests have no Origin header and are allowed.
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------
# Authentication (PHASE 3) — REQUIRED, server generates nothing safe by default
# -----------------------------------------------------------------------
# Two DISTINCT high-entropy random strings. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------
# SMS / OTP delivery — configure a provider for production sign-up and login
# -----------------------------------------------------------------------
# Unset = OTP codes are only logged server-side and echoed in the API
# response for local development (never happens if NODE_ENV=production).
# Supported values: twilio, msg91, custom. Production OTP requests fail closed
# if the provider or its credentials are missing.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------
# Maps & Geocoding (Google Cloud Console)
# -----------------------------------------------------------------------
# Prerequisites in https://console.cloud.google.com:
# 1. Enable Billing for your Google Cloud Project.
# 2. Enable APIs: Places API, Geocoding API, Directions API, Maps SDK for Android, Maps SDK for iOS, and Maps JavaScript API.
#
# Server-side key (Directions, Places Autocomplete/Details, Geocoding, Reverse Geocoding):
GOOGLE_MAPS_SERVER_API_KEY=
# Client-side key (frontend-safe map tile rendering; restrict by bundle ID / HTTP referrer in Google Cloud Console):
EXPO_PUBLIC_GOOGLE_MAPS_CLIENT_API_KEY=
# Full reachable API URL for the app, e.g. https://api.example.com or
# http://192.168.1.20:4000 for a physical device on your local network.
EXPO_PUBLIC_API_URL=

# -----------------------------------------------------------------------
# Payments — Razorpay order, signature, capture verification, webhook, and refund flows
# -----------------------------------------------------------------------
# Get: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Frontend-safe publishable key (Razorpay checkout SDK):
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# -----------------------------------------------------------------------
# Push notifications — Expo push tokens are sent through Expo's push service
# -----------------------------------------------------------------------
# Expo push notifications need no server secret. Set an EAS project ID in the
# mobile build environment so Expo can issue push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# -----------------------------------------------------------------------
# File storage for driver documents / profile photos (PHASE 12)
# -----------------------------------------------------------------------
# Any S3-compatible provider. Documents must be stored PRIVATE (not
# publicly readable) — the API issues short-lived signed URLs on demand.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------
# Password reset looks up the email account and sends a verification OTP to
# its registered phone number; it uses the SMS configuration above.

# -----------------------------------------------------------------------
# WebSocket / real-time tracking (PHASE 7)
# -----------------------------------------------------------------------
# If running Socket.IO on a separate process/port from the REST API.
WS_PORT=4001

# -----------------------------------------------------------------------
# Admin (PHASE 18)
# -----------------------------------------------------------------------
# No public admin signup route exists. Seed the first admin directly in
# the database (set role='admin' on a users row) or via a one-off script
# gated by this token, never a public endpoint.
ADMIN_SEED_TOKEN=
